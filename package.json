{
  "name": "property-ops",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Property management operations app. Postgres (Supabase), deployed on Vercel.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "seed": "node server/seed.js",
    "reset": "rm -rf data/app.db data/app.db-wal data/app.db-shm && npm run seed",
    "cron": "node -e \"import('./server/lib/scheduler.js').then(m=>m.tick('manual')).then(r=>console.log(r))\"",
    "test": "node --env-file=.env.test --test --test-concurrency=1 test/*.test.js",
    "test:watch": "node --env-file=.env.test --test --watch test/*.test.js",
    "db:test": "createdb propops_test 2>/dev/null; echo 'propops_test ready'",
    "check": "npm test && echo ALL_GREEN"
  },
  "dependencies": {
    "@vercel/blob": "^0.27.0",
    "postgres": "^3.4.0",
    "qrcode-generator": "^2.0.4"
  }
}
