# Runtime state. app.db IS the system of record — back it up, don't commit it.
# It also changes on every request, so tracking it makes every diff noise.
data/

node_modules/
*.log
.DS_Store
.vercel
.env
.env.local
.env*.local

# Generated secrets, never committed. See docs/WHERE-TO-GET-KEYS.md.
secrets-*.txt
