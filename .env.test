# The suite's environment. Committed deliberately, because nothing in it is a
# secret and because the alternative is what happened: `npm test` run with the
# production env file loaded and NODE_ENV unset, which dropped the live schema.
#
# Nothing here reaches a real service. The database is local and disposable —
# the suite drops and rebuilds its schema on every run — and the key below
# encrypts only fixture data.

NODE_ENV=test

# Create it with: npm run db:test
TEST_DATABASE_URL=postgresql://localhost:5432/propops_test

# Not a secret. A fixed, obviously-fake 32-byte key so sealed-field tests are
# reproducible. The real one is APP_ENCRYPTION_KEY in the deployment
# environment and never appears in this repository.
APP_ENCRYPTION_KEY=dGVzdC1rZXktbm90LWEtc2VjcmV0LTMyLWJ5dGVzISE=

# A test-mode Stripe key so the Connect calls are exercised through their real
# request-building path. It is not a credential — `sk_test_` keys are rejected
# by Stripe unless they are real, and this one is not. The suite replaces
# global fetch, so nothing leaves the machine.
STRIPE_SECRET_KEY=sk_test_not_a_real_key_for_tests
STRIPE_CONNECT_CLIENT_ID=ca_test_not_a_real_client_id
