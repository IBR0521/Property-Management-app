{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "functions": {
    "api/index.js": { "memory": 512, "maxDuration": 15 },
    "api/cron.js":  { "memory": 512, "maxDuration": 60 }
  },

  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/api/index" }
  ],

  "crons": [
    { "path": "/api/cron", "schedule": "0 9 * * *" }
  ]
}
