{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "functions": {
    "api/index.js": {
      "memory": 512,
      "maxDuration": 15,
      "includeFiles": "{index.html,assets/**,app-assets/**,server/**}"
    },
    "api/cron.js": {
      "memory": 512,
      "maxDuration": 60,
      "includeFiles": "server/**"
    }
  },

  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/api/index" }
  ],

  "crons": [
    { "path": "/api/cron", "schedule": "0 * * * *" }
  ]
}
